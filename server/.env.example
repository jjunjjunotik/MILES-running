# Copy to your host's secret settings. Only DATABASE_URL is required to start.

# Postgres 13 or newer. Managed Postgres works (add ?sslmode=require if the provider wants it).
DATABASE_URL=postgres://miles:miles@127.0.0.1:5432/miles
PORT=8080

# The address the server is reached at. The privacy, terms and account-deletion
# pages live here; the App Store and Google Play listings link to them.
PUBLIC_URL=https://api.example.com

# Who runs MILES. Shown on the privacy policy and terms.
APP_NAME=MILES
COMPANY_NAME=
CONTACT_EMAIL=

# Password reset emails, through Resend (https://resend.com). Without these,
# nobody can reset a forgotten password.
RESEND_API_KEY=
MAIL_FROM=MILES <no-reply@example.com>

# The moderation desk at /admin. A long random string; empty turns /admin off.
ADMIN_TOKEN=

# The Authorization header value set on RevenueCat's webhook. Empty turns the
# webhook off.
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat's secret API key (sk_...). With it a purchase counts the moment
# it is made; without it, when the webhook arrives a few seconds later.
# Server only: the app carries the public appl_/goog_ keys, never this one.
REVENUECAT_API_KEY=

# Behind a load balancer (Fly.io, Render, Railway...) set this so rate limits
# see the runner's address rather than the balancer's.
TRUST_PROXY=true

# Leave false in production: simulated runs must never claim real ground.
ALLOW_SIMULATED_RUNS=false

# Which origins may call the API from a browser. The Android app is
# https://localhost, the iOS app capacitor://localhost. "*" is fine: the API
# uses bearer tokens, not cookies.
CORS_ORIGINS=*
