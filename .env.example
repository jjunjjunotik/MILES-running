# ---------------------------------------------------------------------------
# 이 파일은 예시입니다. 실제 값은 .env 에 넣으세요 (.env 는 git 에 올라가지 않습니다).
#
#   cp .env.example .env
#   chmod 600 .env        # 본인만 읽도록
#
# 키는 절대 채팅·이슈·스크린샷·커밋에 붙여넣지 마세요.
# 한 번 노출된 키는 지워도 소용없고, 폐기 후 재발급만이 답입니다.
#   https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 분석 프로바이더
#
# 둘 중 키가 설정된 쪽으로 자동 선택됩니다. 둘 다 있으면 Gemini 를 씁니다.
# 명시하려면 ANALYSIS_PROVIDER 에 gemini 또는 claude 를 적으세요.
# 어느 쪽이 쓰이는지는 서버 기동 로그에 찍힙니다.
# ---------------------------------------------------------------------------

# ANALYSIS_PROVIDER=gemini

# Google Gemini API 키 (https://aistudio.google.com/apikey)
# 서버에서만 읽히며 브라우저로 전달되지 않습니다.
GEMINI_API_KEY=AIza여기에_키를_넣으세요

# 쓸 모델 (기본 gemini-3.8-flash)
# 404 가 나면 이 키로 그 모델을 쓸 수 없다는 뜻입니다.
# 터미널에서 `npm run models` 를 실행해 쓸 수 있는 목록을 확인하고 여기에 적으세요.
# GEMINI_MODEL=gemini-3.8-flash

# Anthropic API 키 (https://console.anthropic.com/settings/keys)
# 서버에서만 읽히며 브라우저로 전달되지 않습니다.
# 주의: 이름을 VITE_ 로 시작하게 바꾸면 클라이언트 번들에 그대로 새겨집니다.
# ANTHROPIC_API_KEY=sk-ant-여기에_키를_넣으세요

# 서버 포트 (기본 8787)
PORT=8787

# ---------------------------------------------------------------------------
# 계정과 기록이 저장되는 데이터베이스 (Node 내장 SQLite, 별도 설치 불필요)
#
# 이 파일에는 비밀번호 해시와 분석 기록이 들어갑니다. 손톱 사진은 들어가지 않습니다.
# git 에 올라가지 않도록 .gitignore 에 data/ 와 *.db 가 들어 있습니다.
# 배포할 때는 이 경로를 백업 대상에 넣고, 접근 권한을 서버 계정으로 제한하세요.
# ---------------------------------------------------------------------------

# DATA_DIR=./data
# DB_FILE=./data/nailsense.db

# ---------------------------------------------------------------------------
# 소셜 로그인 (선택)
#
# 비워 두면 그 버튼은 로그인 화면에 아예 나타나지 않고, 관련 스크립트도 불러오지
# 않습니다. 이메일 로그인과 "로그인 없이 쓰기"는 설정과 무관하게 항상 됩니다.
# ---------------------------------------------------------------------------

# 구글: https://console.cloud.google.com/apis/credentials 에서 OAuth 클라이언트 ID(웹)를
# 만들고, 승인된 자바스크립트 출처에 이 앱 주소를 넣으세요.
# 클라이언트 아이디는 공개되는 값입니다. 클라이언트 보안 비밀은 이 방식에서 쓰지 않습니다.
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# 애플: 유료 개발자 계정이 필요합니다.
#  1) Services ID 를 만들고 (이것이 APPLE_CLIENT_ID)
#  2) Sign in with Apple 을 켜서 도메인과 Return URL 을 등록하고
#  3) Keys 에서 .p8 키를 받으세요 (KEY_ID 와 TEAM_ID 도 함께 확인)
# APPLE_PRIVATE_KEY 는 .p8 파일 내용을 그대로 넣되, 줄바꿈은 
 으로 이어 붙입니다.
# APPLE_CLIENT_ID=com.example.nailsense.web
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=YYYYYYYYYY
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 로그인·가입 요청 속도 제한 (비밀번호 추측을 늦춘다)
AUTH_RATE_LIMIT_PER_IP=20
AUTH_RATE_LIMIT_GLOBAL=200
AUTH_RATE_LIMIT_WINDOW_MS=600000

# 데모 모드: 키가 없어도 샘플 분석 결과로 UI를 확인할 수 있습니다.
# 공개 배포 시에는 false 로 두어 "왜 샘플이 나오지?" 하는 혼란을 막으세요.
ALLOW_DEMO_FALLBACK=true

# ---------------------------------------------------------------------------
# 남이 내 키로 호출하지 못하게 하는 설정
# ---------------------------------------------------------------------------

# 분석 요청 속도 제한 (창 하나당 허용 횟수)
RATE_LIMIT_PER_IP=12
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_WINDOW_MS=300000

# 앱을 다른 도메인에서 서빙한다면 그 출처를 쉼표로 나열하세요.
# 비워 두면 같은 출처 요청만 받습니다.
# ALLOWED_ORIGINS=https://nailsense.example.com

# 리버스 프록시(nginx, Cloudflare 등) 뒤에 둘 때만 true.
# 켜면 X-Forwarded-For 를 신뢰하므로, 프록시가 앞에 없을 때 켜면
# 아무나 헤더를 위조해 속도 제한을 우회할 수 있습니다.
TRUST_PROXY=false
