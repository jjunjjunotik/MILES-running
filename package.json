{
  "name": "nailsense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nail observation helper that describes how a nail looks in a photo and suggests everyday care tips.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run check:secrets",
    "build:demo": "node scripts/build-demo.mjs && npm run check:secrets",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "models": "node scripts/models.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check:oauth": "node scripts/check-oauth.mjs",
    "check:billing": "node scripts/check-billing.mjs",
    "e2e:billing": "node scripts/e2e-billing.mjs",
    "check:paddle": "node scripts/check-paddle.mjs",
    "smoke:ko": "node scripts/smoke-ko.mjs",
    "build:app": "tsc -p tsconfig.json --noEmit && vite build --mode app && npm run check:secrets",
    "cap:sync": "npm run build:app && cap sync",
    "check:app": "node scripts/check-app.mjs",
    "check:store": "node scripts/check-store.mjs",
    "e2e:store": "node scripts/e2e-store.mjs",
    "make:icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capgo/capacitor-social-login": "^8.5.12",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@google/genai": "^2.22.0",
    "@phosphor-icons/react": "^2.1.10",
    "@revenuecat/purchases-capacitor": "^13.7.0",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
